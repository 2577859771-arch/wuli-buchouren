# Server-only. Never put these in public/ or commit real credentials.
HOST=0.0.0.0
PORT=4178
PHYSICS_DATABASE_PATH=data/physics.sqlite
# Set to the real HTTPS domain before production use.
PUBLIC_ORIGIN=https://YOUR-DOMAIN.example
AI_PROVIDER=qwen
QWEN_API_KEY=
# Use the exact OpenAI-compatible HTTPS endpoint from your provider console.
QWEN_BASE_URL=https://llmapi.paratera.com/v1
# Both IDs must be confirmed against your account's current model list.
QWEN_MODEL=Qwen3.8-Flash
QWEN_VISION_MODEL=Qwen3.8-Flash
QWEN_RESPONSE_FORMAT=json_object
QWEN_ENABLE_THINKING=false
# Server-wide daily AI cap; protects your provider quota. Can be changed 1–1000.
AI_DAILY_GLOBAL_LIMIT=20
# Free beta: maximum upstream attempts, including failed requests; resets at 08:00 China time.
AI_DAILY_USER_LIMIT=5
AI_DAILY_IP_LIMIT=15
# Optional illustration service. Existing precise SVG teaching diagrams need no key.
OPENAI_IMAGE_API_KEY=
# Optional Resend-compatible server-side email sender; verify the sender domain.
MAIL_API_KEY=
MAIL_FROM=
MAIL_API_URL=https://api.resend.com/emails
# Read-only temporary design preview only; keep false in production.
PHYSICS_READONLY_PREVIEW=false
